    "drizzle-orm": "1.0.0-rc.4",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.2",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
